# Suez Tout Sur Mon Eau credentials
SUEZ_EMAIL=your.email@example.com
SUEZ_PASSWORD=your_password
SUEZ_ID_PDS=your_id_pds

# SSL Verification (set to false if you have certificate issues, e.g., behind corporate proxy)
# WARNING: Disabling SSL verification reduces security
VERIFY_SSL=true

# MQTT Configuration
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=water

# Heartbeat Configuration (optional)
# Interval in seconds for publishing heartbeat messages to {MQTT_TOPIC}/heartbeat
HEARTBEAT_INTERVAL=60

# Home Assistant MQTT Discovery (optional)
# Publishes retained HA discovery configs so Home Assistant and the Oikos app
# automatically pick up the water sensors. Set HA_DISCOVERY_ENABLED=false to
# disable (no <HA_DISCOVERY_PREFIX>/... messages will be published).
HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant
HA_DEVICE_NAME=Suez Water
# Optional: publish the state as one retained JSON object
# {"consumption_l", "index_m3", "timestamp"} on this topic instead of the scalar
# <MQTT_TOPIC>/sensor/<name> topics. Pick a topic your history recorder stores
# (e.g. jeedom/data/water for Athena-Core) to get charts in Oikos.
HA_STATE_TOPIC=
